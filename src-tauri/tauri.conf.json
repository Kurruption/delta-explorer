{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Delta Explorer",
  "version": "0.1.0",
  "identifier": "com.deltaexplorer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Delta Explorer", "width": 1200, "height": 760, "minWidth": 720, "minHeight": 440, "decorations": false, "transparent": true, "visible": false }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' data: thumb: http://thumb.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' raw: http://raw.localhost; font-src 'self' raw: http://raw.localhost; frame-src raw: http://raw.localhost; object-src raw: http://raw.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Delta Explorer",
    "shortDescription": "Delta Explorer",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installerIcon": "icons/icon.ico", "installMode": "currentUser", "installerHooks": "windows/hooks.nsh" }
    }
  }
}
